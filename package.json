{
  "name": "bird-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "check:vue": "vue-tsc --noEmit",
    "test": "vp test",
    "fmt": "vp fmt . --write",
    "preview": "vp preview",
    "preview:workers": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "verify": "vp check && vp run check:vue && vp test && vp build"
  },
  "dependencies": {
    "@tresjs/core": "5.9.3",
    "pinia": "4.1.0",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/three": "0.186.0",
    "@types/w3c-web-hid": "1.0.7",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@11.21.0"
}
